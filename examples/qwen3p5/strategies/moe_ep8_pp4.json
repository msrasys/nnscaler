{
  "name": "qwen3p5_397b_a17b_ep8_pp4",
  "description": "Frontier 32-GPU strategy (PP=4 stages x EP/TP=8) for Qwen3.5-397B-A17B (60 layers, 512 experts, expand_moe_ops=false).",
  "mesh": {
    "plan_ngpus": 32,
    "runtime_ngpus": 32,
    "pipeline_nstages": 4,
    "pipeline_size": 4,
    "pipeline_nmicros": 8,
    "pipeline_scheduler": "1f1b",
    "zero_stage": 1,
    "zero_ngroups": 1
  },
  "rewrites": {
    "loss_reduction": "sum-count",
    "wrap_gdn_kernels": true,
    "head_grouped_gdn_qkv": true,
    "static_moe_grouped_gemm": true,
    "expand_moe_ops": false,
    "wrap_vision_ops": true
  },
  "default_partition": "auto",
  "recompute_modules": [
    "layers\\.\\d+"
  ],
  "stage_splits": [
    { "layers": "0..14", "stage_id": 0 },
    { "layers": "15..29", "stage_id": 1 },
    { "layers": "30..44", "stage_id": 2 },
    { "layers": "45..59", "stage_id": 3 }
  ],
  "rules": [
    {
      "name": "moe_routed_experts_ep8",
      "op_regex": "qwen3_5_moe_grouped_gemm",
      "partition": "expert_parallel"
    },
    {
      "name": "moe_shared_expert_col_tp8",
      "fqn_regex": "shared_expert\\.(gate_proj|up_proj)$",
      "op_regex": "linear",
      "partition": "tp_col"
    },
    {
      "name": "moe_shared_expert_row_tp8",
      "fqn_regex": "shared_expert\\.down_proj$",
      "op_regex": "linear",
      "partition": "tp_row"
    },
    {
      "name": "attn_qkv_col_tp8",
      "fqn_regex": "self_attn\\.(q_proj|k_proj|v_proj)$",
      "op_regex": "linear",
      "partition": "tp_col",
      "on_indivisible": "fallback_replicate"
    },
    {
      "name": "attn_sdpa_head_tp8",
      "fqn_regex": "self_attn$",
      "op_regex": "scaled_dot_product_attention",
      "partition": "head_parallel",
      "on_indivisible": "fallback_replicate"
    },
    {
      "name": "attn_o_row_tp8",
      "fqn_regex": "self_attn\\.o_proj$",
      "op_regex": "linear",
      "partition": "tp_row"
    },
    {
      "name": "gdn_in_proj_col_tp8",
      "fqn_regex": "linear_attn\\.(in_proj_qkv|in_proj_z|in_proj_b|in_proj_a)$",
      "op_regex": "linear",
      "partition": "tp_col",
      "on_indivisible": "fallback_replicate"
    },
    {
      "name": "gdn_conv_and_fla_head_tp8",
      "op_regex": "qwen3_5_(causal_conv1d|chunk_gated_delta_rule)",
      "partition": "head_parallel",
      "on_indivisible": "fallback_replicate"
    },
    {
      "name": "gdn_out_proj_row_tp8",
      "fqn_regex": "linear_attn\\.out_proj$",
      "op_regex": "linear",
      "partition": "tp_row"
    },
    {
      "name": "vocab_parallel_lm_head",
      "fqn_regex": "lm_head$",
      "op_regex": "linear",
      "partition": "vocab_parallel"
    }
  ]
}
