 torch::Stream Buffer::get_comm_stream() const {
     return comm_stream;
+}
+
+std::tuple<std::vector<torch::Tensor>, EventHandle> Buffer::peer_exchange_copy(
+    const std::vector<torch::Tensor>& values, bool gather) {
+    EP_HOST_ASSERT(available && num_ranks == 2 && num_nvl_ranks == 2 && num_rdma_ranks == 1);
+    EP_HOST_ASSERT(!values.empty());
+    std::vector<int64_t> offsets, sizes;
+    std::vector<torch::Tensor> outputs;
+    int64_t offset = 0;
+    for (const auto& value: values) {
+        EP_HOST_ASSERT(value.is_cuda() && value.is_contiguous() && value.get_device() == device_id && value.dim() > 0);
+        int64_t bytes = value.numel() * value.element_size();
+        EP_HOST_ASSERT(offset <= num_nvl_bytes && bytes <= num_nvl_bytes - offset);
+        offsets.push_back(offset); sizes.push_back(bytes);
+        offset = ((offset + bytes + 255) / 256) * 256;
+        auto shape = value.sizes().vec();
+        if (gather) shape[0] *= 2;
+        outputs.push_back(torch::empty(shape, value.options()));
+    }
+    auto compute_stream = at::cuda::getCurrentCUDAStream();
+    stream_wait(comm_stream, compute_stream);
+    intranode::barrier(barrier_signal_ptrs_gpu, nvl_rank, num_nvl_ranks, comm_stream);
+    for (size_t i = 0; i < values.size(); ++i) {
+        CUDA_CHECK(cudaMemcpyAsync(static_cast<uint8_t*>(buffer_ptrs[1 - nvl_rank]) + offsets[i],
+                                   values[i].data_ptr(), sizes[i], cudaMemcpyDefault, comm_stream));
+    }
+    intranode::barrier(barrier_signal_ptrs_gpu, nvl_rank, num_nvl_ranks, comm_stream);
+    for (size_t i = 0; i < values.size(); ++i) {
+        auto target = static_cast<uint8_t*>(outputs[i].data_ptr());
+        if (gather) {
+            CUDA_CHECK(cudaMemcpyAsync(target + nvl_rank * sizes[i], values[i].data_ptr(),
+                                       sizes[i], cudaMemcpyDefault, comm_stream));
+            target += (1 - nvl_rank) * sizes[i];
+        }
+        CUDA_CHECK(cudaMemcpyAsync(target, static_cast<uint8_t*>(buffer_ptrs[nvl_rank]) + offsets[i],
+                                   sizes[i], cudaMemcpyDefault, comm_stream));
+        values[i].record_stream(comm_stream);
+        outputs[i].record_stream(comm_stream);
+    }
+    // Returned activations use the ordinary allocator, never a reusable IPC view.
+    return {outputs, EventHandle(comm_stream)};
 }
 
